# Supabase project (Settings → API Keys). Use the secret key (sb_secret_...): server-only, never shipped to the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=
# Password required to delete the snapshot history.
HISTORY_DELETE_PASSWORD=change-me
# Optional: IANA timezone used for "today" (calendar highlight, timeline). Defaults to Africa/Cairo.
# APP_TIMEZONE=Africa/Cairo
# Public origin of the deployed app, used for canonical and Open Graph URLs (og:url, og:image).
# Set it to the production URL on Vercel, e.g. https://ta-load.vercel.app. Defaults to http://localhost:5173.
# APP_URL=http://localhost:5173
